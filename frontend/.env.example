# Откуда брать данные:
#   mock — встроенные моки (по умолчанию, бэкенд не нужен)
#   http — настоящий REST API
VITE_API_MODE=mock

# Базовый URL API для режима http.
# /api — запросы идут на тот же хост, а dev-сервер Vite проксирует их на VITE_PROXY_TARGET.
VITE_API_URL=/api

# Адрес запущенного бэкенда для прокси dev-сервера (только для npm run dev).
# VITE_PROXY_TARGET=http://localhost:8080

# Задержка ответа моков, мс (имитация сети)
VITE_MOCK_DELAY=350
